#!/usr/bin/env bash
# Creates or starts my T3 Code devboxes with these dotfiles, then checks the T3 fix is installed.
set -o errexit -o nounset -o pipefail

names=(dyurinov-1 dyurinov-2 dyurinov-3)
dotfiles_uri=git@github.com:dyurinov/dotfiles.git
coder=${CODER_BIN:-coder}
codez=$HOME/sandbox/asana

status_of() {
    "$coder" list --output json | jq -r --arg name "$1" '.[] | select(.name == $name) | .latest_build.status'
}

has_fix() {
    # --wait=yes also waits for startup scripts, which is when Coder installs dotfiles.
    # SSH commands start in the agent dir (/var/asana-config/asana), not $HOME; $HOME expands on the devbox.
    # shellcheck disable=SC2016
    "$coder" ssh --wait=yes "$1" -- 'test -L "$HOME/.config/zsh/t3-ssh.zsh"'
}

for name in "${names[@]}"; do
    status=$(status_of "$name")
    case $status in
        '')
            printf '%s: creating\n' "$name"
            # z devbox create also sets up commit signing and SSH; BROWSER=true skips the dashboard tab.
            (cd "$codez" && BROWSER=true asana2/asana/tools/zoe/bin/z devbox create -n "$name" \
                --parameter "dotfiles_uri=$dotfiles_uri")
            ;;
        running | starting | pending) printf '%s: %s\n' "$name" "$status" ;;
        *)
            printf '%s: %s, starting\n' "$name" "$status"
            "$coder" start --yes --parameter "dotfiles_uri=$dotfiles_uri" "$name"
            ;;
    esac
done

# Prints each of claude and codex that has no subscription login. Reads the login files instead of
# asking the tools: the devbox's codex wrapper logs in with the shared API key when it finds none.
login_check='
import json, pathlib
home = pathlib.Path.home()
def read(path):
    try:
        return json.loads((home / path).read_text())
    except (OSError, ValueError):
        return {}
if not read(".claude.json").get("oauthAccount"):
    print("claude")
if read(".codex/auth.json").get("auth_mode") != "chatgpt":
    print("codex")
'

missing_logins() {
    printf '%s' "$login_check" | "$coder" ssh "$1" -- python3 -
}

login_command() {
    case $2 in
        claude) printf 'ssh -t coder.%s claude auth login' "$1" ;;
        codex) printf 'ssh -t coder.%s codex login --device-auth' "$1" ;;
    esac
}

check_logins() {
    local name=$1 tool command answer
    for tool in $(missing_logins "$name"); do
        command=$(login_command "$name" "$tool")
        printf '%s: %s is not logged in\n' "$name" "$tool"
        if [ -t 0 ]; then
            read -r -p "  Log in now with \`$command\`? [Y/n] " answer
            if [ "${answer:-y}" != n ] && [ "${answer:-y}" != N ]; then
                $command || printf '%s: %s login failed\n' "$name" "$tool" >&2
            fi
        else
            printf '  Log in with: %s\n' "$command"
        fi
    done
}

for name in "${names[@]}"; do
    if ! has_fix "$name"; then
        printf '%s: T3 fix missing, restarting with dotfiles\n' "$name"
        "$coder" restart --yes --parameter "dotfiles_uri=$dotfiles_uri" "$name"
        has_fix "$name" || { printf '%s: T3 fix still missing\n' "$name" >&2; exit 1; }
    fi
    check_logins "$name"
    printf '%s: ready, add it in T3 Code as coder.%s\n' "$name" "$name"
done

"$(dirname -- "${BASH_SOURCE[0]}")/devbox-forwards"
