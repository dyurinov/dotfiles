#!/usr/bin/env bash
# Pre-installs this Mac's T3 Code version on each devbox, in the layout T3's SSH launcher checks
# (~/.t3/runtime/versions/<version> with .install-complete), so the next connect starts at once.
# A running T3 server keeps its old version until T3 restarts it (remove and re-add, or reconnect).
set -o errexit -o nounset -o pipefail

if [ $# -gt 0 ]; then names=("$@"); else names=(dyurinov-1 dyurinov-2 dyurinov-3); fi
app=${T3_APP:-"/Applications/T3 Code (Nightly).app"}
version=${T3_VERSION:-$(defaults read "$app/Contents/Info" CFBundleShortVersionString)}

# Mirrors REMOTE_RUNNER_SCRIPT in t3code packages/ssh/src/tunnel.ts.
install_script='
set -eu
version=$1
dir="$HOME/.t3/runtime/versions/$version"
if [ "$(cat "$dir/.install-complete" 2>/dev/null)" = "$version" ] && [ -x "$dir/t3" ]; then
    echo "already installed"; exit 0
fi
base=https://github.com/pingdotgg/t3code/releases/download/v$version
archive=t3-$version-linux-x64.tar.gz
mkdir -p "$HOME/.t3/runtime/versions"
staging=$(mktemp -d "$HOME/.t3/runtime/versions/.staging-XXXXXX")
trap "rm -rf \"$staging\"" EXIT
curl -fsSL --connect-timeout 30 --max-time 60 "$base/SHA256SUMS" -o "$staging/SHA256SUMS"
curl -fsSL --connect-timeout 30 --max-time 600 "$base/$archive" -o "$staging/$archive"
expected=$(grep " \*\{0,1\}$archive$" "$staging/SHA256SUMS" | cut -d" " -f1)
actual=$(sha256sum "$staging/$archive" | cut -d" " -f1)
[ -n "$expected" ] && [ "$actual" = "$expected" ] || { echo "checksum mismatch" >&2; exit 1; }
tar -xzf "$staging/$archive" -C "$staging" --strip-components=1
rm -f "$staging/$archive" "$staging/SHA256SUMS"
"$staging/t3" --version >/dev/null
printf "%s\n" "$version" >"$staging/.install-complete"
rm -rf "$dir"
mv "$staging" "$dir"
trap - EXIT
echo "installed"
'

for name in "${names[@]}"; do
    printf '%s: t3 %s ' "$name" "$version"
    printf '%s' "$install_script" | ssh -o BatchMode=yes "coder.$name" sh -s -- "$version" 2>&1 |
        grep -v -i -E 'startup script|troubleshooting|incomplete'
done
